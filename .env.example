# No credentials belong in source. Admin is set up interactively, not here.
MLAM_DATA_DIR=./data
# Set this to the one purchased HTTPS domain before deployment.
MLAM_ORIGIN=http://127.0.0.1:4180
# Enable ONLY after your sole trusted reverse proxy strips and overwrites
# X-MLAM-Client-IP with the real connection IP. Do not expose Node directly.
MLAM_TRUST_PROXY_IP=0

# Supabase customer authentication. Use a publishable key, never service_role.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Admin may sign in only with this verified Supabase email. Keep it server-only.
MLAM_ADMIN_EMAIL=
# In Supabase, allow MLAM_ORIGIN/auth/callback and enable Google + Confirm email.

# Local test sign-in for /admin before Supabase is ready: set to 1 and any
# email/password works, but only under `npm run dev` on 127.0.0.1/localhost.
# Production builds ignore it. Never set it on a hosted server.
MLAM_DEV_ADMIN=

# Email from the admin (license keys, launch announcements) through Resend.
# Leave empty to have the admin open your own email app instead. The From
# address must be on a domain verified in Resend, e.g. "MLAM Studio Pro <hello@yourdomain.com>".
RESEND_API_KEY=
MLAM_EMAIL_FROM=

# Cloudflare R2 file storage (ZIPs, demos, videos, product images).
# Leave all four empty to keep files in MLAM_DATA_DIR/uploads on this server.
# Set all four to store them in R2; a partial setup is refused. Use an R2 API
# token scoped to this one bucket with Object Read & Write. See R2-SETUP.md.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
