# No credentials belong in source. Admin is set up interactively, not here.
MLAM_DATA_DIR=./data
# Set this to the one purchased HTTPS domain before deployment.
MLAM_ORIGIN=http://127.0.0.1:4180
# Enable ONLY after your sole trusted reverse proxy strips and overwrites
# X-MLAM-Client-IP with the real connection IP. Do not expose Node directly.
MLAM_TRUST_PROXY_IP=0

# Supabase customer authentication. Use a publishable key, never service_role.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Admin may sign in only with this verified Supabase email. Keep it server-only.
MLAM_ADMIN_EMAIL=
# In Supabase, allow MLAM_ORIGIN/auth/callback and enable Google + Confirm email.
